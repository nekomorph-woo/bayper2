{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bayper Tauri Probe",
  "version": "0.1.31",
  "identifier": "dev.bayper.windowprobe",
  "build": {
    "frontendDist": "../shared"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "probe",
        "title": "Bayper Tauri Probe",
        "width": 240,
        "height": 240,
        "x": 400,
        "y": 300,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "incognito": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
