{
  "name": "bayper",
  "version": "0.1.205",
  "private": true,
  "description": "Bayper 桌面陪伴应用",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit/*.test.cjs",
    "test:acceptance": "node --test tests/acceptance/companionship.spec.cjs && node --test --test-concurrency=1 tests/acceptance/onboarding.spec.cjs tests/acceptance/companionship-ui.spec.cjs tests/acceptance/desktop.spec.cjs",
    "test:live": "node --test tests/acceptance/live-onboarding.spec.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "playwright": "1.64.1"
  }
}
